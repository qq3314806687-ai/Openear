# ——— OpenEar LLM 理由润色配置（可选）———
# 遵循 PRD：LLM 仅用于推荐理由的文本润色，绝不参与推荐排序。
#
# 留空或删除 OPENAI_API_KEY 时，/api/explain 接口会自动降级
# 返回规则模板理由，不影响核心推荐功能。
#
# DeepSeek 默认值；其它 OpenAI 兼容端点可改 baseURL 与 model。

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_MS=8000

# ——— 音乐日记 · 播放截图识别（可选）———
# 用视觉模型从截图里读 歌名 / 歌手 / 风格；识别不到时前端自动回退示例曲库。
# 留空或删除 OPENAI_API_KEY 时，/api/recognize 直接返回 NOT_CONFIGURED，不影响贴纸功能。
#
# VISION_MODEL 需要是支持图片输入、且与 OPENAI_BASE_URL 同源的模型。
# DeepSeek 用 deepseek-flash；换别的端点时把 OPENAI_BASE_URL / OPENAI_API_KEY 一起改掉即可。
VISION_MODEL=deepseek-flash
VISION_TIMEOUT_MS=15000